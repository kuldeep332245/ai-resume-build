{
  "version": 2,
  "builds": [
    {
      "src": "frontend/dist/**",
      "use": "@vercel/static-build"
    }
  ],
  "routes": [
    {
      "src": "/admin",
      "dest": "/frontend/dist/index.html"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/frontend/dist/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/index.html"
    }
  ]
}